PORT=3000
JWT_SECRET=change-this-to-a-long-random-string
ALLOWED_ORIGINS=http://localhost:3000,https://vphone.app

# Signalling server URL (bridge connects back to itself)
# Leave as default when running locally; update for production
SIGNALLING_WS_URL=ws://localhost:3000/ws

# ── Android backend ───────────────────────────────────────────
# "browserstack"  → real devices via BrowserStack (dev/testing)
# "qemu"          → QEMU/KVM on Mumbai VM (production)
ANDROID_BACKEND=browserstack

# BrowserStack credentials (required when ANDROID_BACKEND=browserstack)
# Get from: https://app-automate.browserstack.com/dashboard
BS_USER=your_browserstack_username
BS_KEY=your_browserstack_access_key

# QEMU paths (required when ANDROID_BACKEND=qemu)
ANDROID_IMAGES_DIR=/opt/vphone/android-images
INSTANCES_DIR=/opt/vphone/instances
QEMU_BIN=qemu-system-x86_64
